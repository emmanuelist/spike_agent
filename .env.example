# Copy to .env and fill in. Never commit the real .env.

GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1

# Route Gemini through Vertex AI (uses your gcloud credentials, no API key).
GOOGLE_GENAI_USE_VERTEXAI=TRUE

# Alternative: hit the Gemini API directly with a key from aistudio.google.com.
# Set GOOGLE_GENAI_USE_VERTEXAI=FALSE and uncomment the line below.
# GOOGLE_API_KEY=

# Hackathon requires Gemini 3.5 or newer. gemini-3.6-flash also qualifies.
GEMINI_MODEL=gemini-3.5-flash
